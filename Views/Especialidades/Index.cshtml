@model IEnumerable<ClinicaVida.Web.Models.Especialidade>
@{
    ViewData["Title"] = "Especialidades";
    var quantidadePorEspecialidade = (Dictionary<int, int>)ViewBag.QuantidadePorEspecialidade;
}

<section class="cabecalho-pagina">
    <div>
        <p class="eyebrow">Clínica Vida+</p>
        <h1>Especialidades</h1>
        <p>Conheça as áreas de atendimento e a quantidade de médicos disponíveis em cada uma.</p>
    </div>
    <a class="botao" asp-controller="Medicos" asp-action="Index">Ver médicos</a>
</section>

<div class="cards">
@foreach (var especialidade in Model)
{
    var quantidade = quantidadePorEspecialidade.TryGetValue(especialidade.Id, out var total) ? total : 0;
    <article class="card">
        <div class="card-topo">
            <h2>@especialidade.Nome</h2>
            <span class="badge">@quantidade médico@(quantidade == 1 ? "" : "s")</span>
        </div>
        <p>@especialidade.Descricao</p>
        <a asp-controller="Medicos" asp-action="Index" asp-route-especialidade="@especialidade.Id">Ver médicos</a>
    </article>
}
</div>
